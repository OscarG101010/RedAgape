@page
@model IndexModel
@using System.Security.Claims
@using Red_Agape.Models
@{
    // Define el título que se muestra en la pestaña del navegador.
    ViewData["Title"] = "Red Ágape - Una red para compartir y ayudar";
}
<!-- Enlace a la hoja de estilos -->
<link rel="stylesheet" href="~/css/index-agape.css" />

<!-- BARRA DE NAVEGACIÓN -->
<header class="agape-navbar">
    <div class="container nav-container">
        <!-- Logotipo y nombre de la plataforma. -->
        <a href="/" class="brand-logo">
            <span class="logo-placeholder">♥</span>
            <span class="brand-name">Red Ágape</span>
        </a>
        <nav class="nav-links">
            <!-- Enlaces principales para recorrer las secciones de la página. -->
            <a href="#proyecto">El Proyecto</a>
            <a href="#equipo">Equipo Ágape</a>
            <!-- Enlaces hacia las futuras pantallas del proyecto -->
            <a asp-page="/" class="btn-link">Recibir Donación</a>
            <a asp-page="/Donar" class="btn-primary-agape">Quiero Donar</a>

            <!-- NUEVO: Botón y Cajita Flotante a la derecha de "Quiero Donar" -->
            <div class="user-menu-wrapper" id="userMenuWrapper">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    // Obtiene el rol y el nombre completo desde las claims de la sesión actual.
                    var rolActual = User.FindFirstValue(ClaimTypes.Role) ?? RolesAgape.UsuarioFinal;
                    var nombreCompleto = User.FindFirstValue("NombreCompleto") ?? User.Identity.Name;

                    <!-- En el botón superior mostramos el Nombre de Usuario (o solo el primer nombre si no hubiera) -->
                    <button type="button" class="btn-user-toggle" id="btnUserToggle">
                        <span>👤 @User.Identity.Name</span>
                        <span class="role-pill">@rolActual</span>
                        <span>▾</span>
                    </button>

                    <!-- Cajita flotante cuando el usuario YA inició sesión -->
                    <div class="auth-dropdown-box" id="authDropdownBox">
                        <div class="user-session-info">
                            <p><strong>Hola, @nombreCompleto</strong></p>
                            <p class="text-secondary-agape">Usuario: <strong>@@@User.Identity.Name</strong> · Rol: <strong>@rolActual</strong></p>
                        </div>

                        <div class="user-QuickLinks">
                            <!-- Los enlaces de gestión solo se muestran a los roles autorizados. -->
                            @if (User.IsInRole(RolesAgape.Administrador))
                            {
                                <a href="#panel-admin">⚙️ Panel de Administración</a>
                                <a href="#gestion-usuarios">🛡️ Gestionar Roles y Usuarios</a>
                            }
                            @if (User.IsInRole(RolesAgape.Organizador) || User.IsInRole(RolesAgape.Administrador))
                            {
                                <a href="#validar-donativos">📦 Validar Donaciones</a>
                            }
                            <a href="#mis-donaciones">❤️ Mis Solicitudes / Donativos</a>
                        </div>

                        <form method="post" asp-page-handler="Logout">
                            <button type="submit" class="btn-outline-agape full-width">Cerrar Sesión</button>
                        </form>
                    </div>
                }
                else
                {
                    // Cuando no hay una sesión activa se muestran las opciones de acceso y registro.
                    <button type="button" class="btn-user-toggle" id="btnUserToggle">
                        <span>👤 Mi Cuenta</span>
                        <span>▾</span>
                    </button>

                    <!-- Cajita flotante con pestañas Iniciar Sesión / Registrarse -->
                    <div class="auth-dropdown-box @(TempData["AbrirCajita"] != null ? "show" : "")" id="authDropdownBox">
                        @if (TempData["MensajeAuth"] != null)
                        {
                            <div class="auth-alert">@TempData["MensajeAuth"]</div>
                        }

                        <div class="auth-tabs">
                            <!-- Las pestañas permiten alternar entre iniciar sesión y registrarse. -->
                            <button type="button" class="auth-tab-btn @(TempData["TabActiva"]?.ToString() == "registro" ? "" : "active")" onclick="cambiarTabAuth('login', this)">Iniciar Sesión</button>
                            <button type="button" class="auth-tab-btn @(TempData["TabActiva"]?.ToString() == "registro" ? "active" : "")" onclick="cambiarTabAuth('registro', this)">Registrarse</button>
                        </div>

                        <!-- Pestaña 1: Iniciar Sesión -->
                        <div id="tab-login" class="auth-tab-pane @(TempData["TabActiva"]?.ToString() == "registro" ? "" : "active")">
                            <!-- El formulario envía las credenciales al handler OnPostLoginAsync. -->
                            <form method="post" asp-page-handler="Login">
                                <div class="form-group">
                                    <label for="loginCorreo">Correo o Nombre de usuario</label>
                                    <input type="text" id="loginCorreo" name="CorreoOUsuario" required placeholder="tu@correo.com o usuario" />
                                </div>
                                <div class="form-group">
                                    <label for="loginPassword">Contraseña</label>
                                    <div class="password-input-wrapper">
                                        <input type="password" id="loginPassword" name="Password" required placeholder="••••••••" />
                                        <button type="button" class="btn-eye-toggle" onclick="toggleVerPassword('loginPassword', this)" title="Mostrar contraseña">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn-primary-agape full-width">Entrar</button>
                            </form>
                        </div>

                        <!-- Pestaña 2: Registrarse -->
                        <div id="tab-registro" class="auth-tab-pane @(TempData["TabActiva"]?.ToString() == "registro" ? "active" : "")">
                            <!-- La validación del navegador se ejecuta antes de enviar el registro al servidor. -->
                            <form method="post" asp-page-handler="Registro" onsubmit="return validarFormularioRegistro()">
                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label for="regNombres">Nombre(s)</label>
                                        <input type="text" id="regNombres" name="Nombres" required placeholder="Ej. Ricardo" />
                                    </div>
                                    <div class="form-group">
                                        <label for="regApellidos">Apellidos</label>
                                        <input type="text" id="regApellidos" name="Apellidos" required placeholder="Ej. Ontiveros" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="regUsername">Nombre de usuario</label>
                                    <input type="text" id="regUsername" name="NombreUsuario" required placeholder="Ej. Ricardo_Agape" pattern="^[a-zA-Z0-9_.-]{3,20}$" title="De 3 a 20 letras, números, guion o punto (sin espacios)" />
                                </div>

                                <div class="form-group">
                                    <label for="regCorreo">Correo electrónico</label>
                                    <input type="email" id="regCorreo" name="Correo" required placeholder="tu@correo.com" />
                                </div>

                                <div class="form-group">
                                    <label for="regPassword">Contraseña</label>
                                    <div class="password-input-wrapper">
                                        <input type="password" id="regPassword" name="Password" required placeholder="Crea tu contraseña" oninput="verificarSeguridadPassword()" />
                                        <button type="button" class="btn-eye-toggle" onclick="toggleVerPassword('regPassword', this)" title="Mostrar contraseña">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Checklist dinámico de seguridad -->
                                <ul class="password-rules" id="passwordRulesList">
                                    <li id="rule-length">○ Mínimo 8 caracteres</li>
                                    <li id="rule-upper">○ Al menos una letra mayúscula (A-Z)</li>
                                    <li id="rule-special">○ Un carácter especial (@@, #, $, %, !, *, etc.)</li>
                                    <li id="rule-match">○ Las contraseñas coinciden</li>
                                </ul>

                                <div class="form-group">
                                    <label for="regConfirmPassword">Confirmar contraseña</label>
                                    <div class="password-input-wrapper">
                                        <input type="password" id="regConfirmPassword" name="ConfirmarPassword" required placeholder="Repite tu contraseña" oninput="verificarSeguridadPassword()" />
                                        <button type="button" class="btn-eye-toggle" onclick="toggleVerPassword('regConfirmPassword', this)" title="Mostrar contraseña">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </button>
                                    </div>
                                </div>

                                <button type="submit" class="btn-primary-agape full-width">Crear Cuenta</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </div>
</header>

<main class="agape-main">

    <!-- SECCIÓN HERO (Primera impresión) -->
    <!-- Presentación principal y accesos rápidos a las acciones más importantes. -->
    <section class="hero-section">
        <div class="container hero-grid">
            <div class="hero-content">
                <span class="badge-secondary">Economía Circular Solidaria</span>
                <h1>Red Ágape: <span class="highlight">Una red para compartir y ayudar</span></h1>
                <p class="hero-description">
                    Establecemos una red social gratuita y transparente que permite sostener y asegurar una ayuda proveniente del corazón, conectando directamente a personas que desean donar artículos en buen estado con quienes más los necesitan.
                </p>
                <div class="hero-actions">
                    <a asp-page="/RegistroDonativo" class="btn-primary-agape">Registrar una Donación</a>
                    <a href="#voluntariado-ecos" class="btn-outline-agape">Ser Voluntario</a>
                </div>
            </div>

            <div class="hero-image-box">
                <!-- Colocar aquí imagen generada o modificada con IA con camiseta de Red Ágape -->
                <div class="image-skeleton">
                    <span>[Imagen: Voluntarios con camiseta de Red Ágape entregando donaciones]</span>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: SOBRE EL PROYECTO Y PROPUESTA DE VALOR -->
    <!-- Explica el propósito de Red Ágape y sus beneficios para la comunidad. -->
    <section id="proyecto" class="section-alt">
        <div class="container">
            <div class="section-header">
                <h2>De corazón a corazón, sin transacciones monetarias</h2>
                <p class="text-secondary-agape">
                    Eliminamos las barreras de la donación tradicional facilitando el contacto seguro entre donantes y beneficiarios.
                </p>
            </div>

            <div class="cards-grid-3">
                <article class="agape-card">
                    <div class="card-icon">🏠</div>
                    <h3>Familias Jóvenes</h3>
                    <p>
                        Ideal para hogares que acumulan artículos infantiles, ropa, juguetes y electrodomésticos en excelente estado y buscan liberar espacio sabiendo que quedarán en buenas manos.
                    </p>
                </article>

                <article class="agape-card">
                    <div class="card-icon">🌱</div>
                    <h3>Jóvenes y Universitarios</h3>
                    <p>
                        Un espacio tecnológico impulsado por la conciencia social y la economía circular para visualizar y compartir el impacto real de cada aportación en la comunidad.
                    </p>
                </article>

                <article class="agape-card">
                    <div class="card-icon">🤝</div>
                    <h3>100% Transparente</h3>
                    <p>
                        Cualquier objeto útil encuentra un nuevo propósito mediante coordinación directa y segura, asegurando que la ayuda llegue íntegramente a quien la necesita.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: CATEGORÍAS DE DONACIÓN (Vista previa de lo que se recibe) -->
    <!-- Muestra los tipos de artículos que se pueden donar o solicitar. -->
    <section id="categorias" class="section-standard">
        <div class="container">
            <div class="section-header">
                <h2>¿Qué puedes donar o solicitar?</h2>
                <p class="text-secondary-agape">Artículos en buen estado listos para tener una segunda vida.</p>
            </div>

            <div class="categories-grid">
                <div class="category-item">
                    <span class="cat-icon">👕</span>
                    <h4>Ropa y Calzado</h4>
                    <p class="text-secondary-agape">Prendas para todas las edades en buen estado.</p>
                </div>
                <div class="category-item">
                    <span class="cat-icon">🔌</span>
                    <h4>Electrodomésticos</h4>
                    <p class="text-secondary-agape">Artículos del hogar funcionales que ya no utilices.</p>
                </div>
                <div class="category-item">
                    <span class="cat-icon">🥫</span>
                    <h4>Alimentos</h4>
                    <p class="text-secondary-agape">Comida no perecedera y despensa básica.</p>
                </div>
                <div class="category-item">
                    <span class="cat-icon">🧸</span>
                    <h4>Juguetes y Otros</h4>
                    <p class="text-secondary-agape">Artículos infantiles, libros y objetos útiles.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: GALERÍA DE IMPACTO (Para las fotos modificadas con IA) -->
    <!-- Galería de ejemplo para mostrar el impacto de las donaciones. -->
    <section id="comunidad" class="section-alt">
        <div class="container">
            <div class="section-header">
                <h2>Nuestra Comunidad en Acción</h2>
                <p class="text-secondary-agape">Personas reales compartiendo y ayudando a través de Red Ágape.</p>
            </div>

            <div class="gallery-grid">
                <!-- Reemplazar los divs .gallery-placeholder por etiquetas <img src="..." con url de la imagen real /> -->
                <div class="gallery-card">
                    <div class="gallery-placeholder">[Foto: Entrega de ropa con camiseta Red Ágape]</div>
                    <p class="gallery-caption">Donación de ropa de temporada</p>
                </div>
                <div class="gallery-card">
                    <div class="gallery-placeholder">[Foto2: Donación de despensa con camiseta Red Ágape]</div>
                    <p class="gallery-caption">Apoyo alimentario comunitario</p>
                </div>
                <div class="gallery-card">
                    <div class="gallery-placeholder">[Foto: Entrega de electrodomésticos]</div>
                    <p class="gallery-caption">Segundo propósito para artículos del hogar</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: NUESTRO EQUIPO (Equipo Ágape) -->
    <!-- Presenta a las personas responsables del desarrollo del proyecto. -->
    <section id="equipo" class="section-standard">
        <div class="container">
            <div class="section-header">
                <h2>Conoce al Equipo Ágape</h2>
                <p class="text-secondary-agape">Desarrolladores detrás de la plataforma Red Ágape.</p>
            </div>

            <div class="cards-grid-3">
                <div class="team-card">
                    <div class="avatar-placeholder">RO</div>
                    <h3>Ricardo Ismael Ontiveros Hernandez</h3>
                    <span class="role-badge">Co-fundador & Desarrollador</span>
                </div>

                <div class="team-card">
                    <div class="avatar-placeholder">ID</div>
                    <h3>Ian Fernando Delgado Rodriguez</h3>
                    <span class="role-badge">Co-fundador & Desarrollador</span>
                </div>

                <div class="team-card">
                    <div class="avatar-placeholder">ÓP</div>
                    <h3>Óscar Giovanni Pérez Montoya</h3>
                    <span class="role-badge">Co-fundador & Desarrollador</span>
                </div>
            </div>
        </div>
    </section>

    

</main>

<!-- FOOTER -->
<footer class="agape-footer">
    <div class="container footer-content">
        <div class="footer-brand">
            <h3>Red Ágape</h3>
            <p>Una red para compartir y ayudar.</p>
        </div>
        <div class="footer-academic">
            <p><strong>Proyecto Final:</strong> Programación Orientada a Objetos 2</p>
            <p><strong>Profesor:</strong> Ing. Jesus Samuel Villalobos Escobar</p>
            <p>&copy; @DateTime.Now.Year - Equipo Ágape</p>
        </div>
    </div>
</footer>

@section Scripts {
    <script>
        // Referencias a los elementos que controlan el menú de usuario.
        const btnToggle = document.getElementById('btnUserToggle');
        const dropdownBox = document.getElementById('authDropdownBox');
        const wrapper = document.getElementById('userMenuWrapper');

        if (btnToggle && dropdownBox) {
            // Abre o cierra el menú al pulsar el botón de usuario.
            btnToggle.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdownBox.classList.toggle('show');
            });

            dropdownBox.addEventListener('click', function (e) {
                e.stopPropagation();
            });

            document.addEventListener('click', function (e) {
                // Cierra el menú cuando se hace clic fuera de él.
                if (wrapper && !wrapper.contains(e.target)) {
                    dropdownBox.classList.remove('show');
                }
            });
        }

        function cambiarTabAuth(tabName, btnElement) {
            // Desactiva la pestaña actual y activa la seleccionada.
            document.querySelectorAll('.auth-tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.auth-tab-btn').forEach(b => b.classList.remove('active'));

            document.getElementById('tab-' + tabName).classList.add('active');
            btnElement.classList.add('active');
        }

        function verificarSeguridadPassword() {
            // Comprueba en tiempo real los requisitos de seguridad de la contraseña.
            const pwd = document.getElementById('regPassword')?.value || '';
            const confirmPwd = document.getElementById('regConfirmPassword')?.value || '';

            const tieneLongitud = pwd.length >= 8;
            const tieneMayuscula = /[A-ZÁÉÍÓÚÑ]/.test(pwd);
            const tieneEspecial = /[@@#$%!^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(pwd);
            const coinciden = pwd.length > 0 && pwd === confirmPwd;

            actualizarItemRegla('rule-length', tieneLongitud, 'Mínimo 8 caracteres');
            actualizarItemRegla('rule-upper', tieneMayuscula, 'Al menos una letra mayúscula (A-Z)');
            actualizarItemRegla('rule-special', tieneEspecial, 'Un carácter especial (@@, #, $, %, !, *, etc.)');
            actualizarItemRegla('rule-match', coinciden, 'Las contraseñas coinciden');

            return tieneLongitud && tieneMayuscula && tieneEspecial && coinciden;
        }

        function actualizarItemRegla(idElemento, cumple, texto) {
            // Actualiza el indicador visual de una regla de contraseña.
            const li = document.getElementById(idElemento);
            if (!li) return;
            if (cumple) {
                li.classList.add('valid');
                li.textContent = '✔ ' + texto;
            } else {
                li.classList.remove('valid');
                li.textContent = '○ ' + texto;
            }
        }

        function validarFormularioRegistro() {
            // Impide el envío si alguna regla de seguridad no se cumple.
            if (!verificarSeguridadPassword()) {
                alert('Por favor asegúrate de que la contraseña cumpla con todos los requisitos de seguridad y que ambas coincidan.');
                return false;
            }
            return true;
        }

        function toggleVerPassword(inputId, btnEye) {
            // Alterna entre mostrar y ocultar el contenido de un campo de contraseña.
            const input = document.getElementById(inputId);
            if (!input) return;

            const svgOjoAbierto = '<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
            const svgOjoTachado = '<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

            if (input.type === 'password') {
                input.type = 'text';
                btnEye.innerHTML = svgOjoTachado;
                btnEye.title = 'Ocultar contraseña';
            } else {
                input.type = 'password';
                btnEye.innerHTML = svgOjoAbierto;
                btnEye.title = 'Mostrar contraseña';
            }
        }
    </script>
}