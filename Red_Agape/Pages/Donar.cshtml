
@page
@model Red_Agape.Pages.DonarModel

<link rel="stylesheet" href="~/css/index-agape.css" />
<link rel="stylesheet" href="~/css/donar.css" />
<partial name="_NavbarAgape" />

<main class="agape-main">
<div class="pagina-donar">

    <div class="tarjeta">

        <header class="encabezado-donar">
            <h1>Haz una donación</h1>
            <p>Tus artículos pueden hacer la diferencia.</p>
        </header>

        <form class="form-donar" method="post" asp-page-handler="Donacion" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"></div>

            <!-- Información del donante -->
            <section class="campo campo-donante">
                <label>Nombre del donante</label>
                <span class="donante-nombre">@User.Identity?.Name</span>
            </section>

            <!-- Tipo de entrega -->
            <section class="tipo-entrega">

                <h2>¿Cómo deseas entregar tus artículos?</h2>

                <label class="opcion">
                    <input type="radio"
                           asp-for="Input.TipoEntrega"
                           value="Recoleccion" />

                    <span>
                        <strong>Recolección a domicilio</strong>
                        <small>Pasaremos por tus artículos.</small>
                    </span>
                </label>

                <label class="opcion">
                    <input type="radio"
                           asp-for="Input.TipoEntrega"
                           value="EntregaDirecta" />

                    <span>
                        <strong>Punto de encuentro</strong>
                        <small>Llevarás los artículos personalmente.</small>
                    </span>
                </label>

                <span asp-validation-for="Input.TipoEntrega"></span>

            </section>

            <!-- Dirección -->
            <section class="campo">

                <label asp-for="Input.DireccionRecoger">
                    Dirección de recolección
                </label>

                <input asp-for="Input.DireccionRecoger"
                       placeholder="Calle, número, colonia..." />

                <span asp-validation-for="Input.DireccionRecoger"></span>

            </section>

            <!-- Zona -->
            <section class="campo">

                <label asp-for="Input.ZonaId">Zona</label>

                <select asp-for="Input.ZonaId" asp-items="Model.Zonas">
                    <option value="">Selecciona tu zona...</option>
                </select>

                <span asp-validation-for="Input.ZonaId"></span>

            </section>

            <!-- Organización -->
            <section class="campo">

                <label asp-for="Input.OrgDestinoId">
                    Organización destinataria
                </label>

                <select asp-for="Input.OrgDestinoId"
                        asp-items="Model.Organizaciones">
                    <option value="">Selecciona una organización...</option>
                </select>

                <span asp-validation-for="Input.OrgDestinoId"></span>

            </section>

            <!-- Descripción general -->
            <section class="campo">

                <label asp-for="Input.Descripcion">
                    Comentarios adicionales
                </label>

                <textarea asp-for="Input.Descripcion"
                          placeholder="Agrega información adicional sobre tu donación..."></textarea>

                <span asp-validation-for="Input.Descripcion"></span>

            </section>

            <!-- Artículos -->
            <div class="lista-articulos">

                <h2>Artículos para donar</h2>

                <div id="contenedor-articulos">

                    @for (var i = 0; i < Model.Input.Articulos.Count; i++)
                    {
                        <div class="articulo" data-articulo>

                            <div class="articulo-header">
                                <h3>
                                    Artículo <span class="num">@(i + 1)</span>
                                </h3>

                                <button type="button" class="btn-quitar">
                                    Quitar
                                </button>
                            </div>

                            <label asp-for="Input.Articulos[i].Nombre">
                                Nombre
                            </label>

                            <input asp-for="Input.Articulos[i].Nombre" />

                            <span asp-validation-for="Input.Articulos[i].Nombre"></span>


                            <label asp-for="Input.Articulos[i].Descripcion">
                                Descripción
                            </label>

                            <input asp-for="Input.Articulos[i].Descripcion" />

                            <span asp-validation-for="Input.Articulos[i].Descripcion"></span>


                            <label asp-for="Input.Articulos[i].Cantidad">
                                Cantidad
                            </label>

                            <input asp-for="Input.Articulos[i].Cantidad"
                                   type="number"
                                   min="1" />

                            <span asp-validation-for="Input.Articulos[i].Cantidad"></span>


                            <label asp-for="Input.Articulos[i].Condicion">
                                Condición
                            </label>

                            <select asp-for="Input.Articulos[i].Condicion">
                                <option value="">Selecciona...</option>
                                <option value="Nuevo">Nuevo</option>
                                <option value="BuenEstado">Buen estado</option>
                                <option value="Usada">Usada</option>
                            </select>

                            <span asp-validation-for="Input.Articulos[i].Condicion"></span>


                            <label asp-for="Input.Articulos[i].Foto">Fotografía</label>

                            <div class="foto-campo">
                                <input asp-for="Input.Articulos[i].Foto" type="file" accept="image/*" />

                                <img class="foto-preview" alt="Vista previa de la fotografía" hidden />

                                <button type="button" class="btn-quitar-foto" hidden>Quitar foto</button>
                            </div>

                            <span asp-validation-for="Input.Articulos[i].Foto"></span>

                        </div>
                    }

                </div>

            </div>

            <!-- Acciones -->
            <div class="acciones">

                <button type="button"
                        class="btn-secundario"
                        id="btn-agregar">
                    + Agregar artículo
                </button>

                <button type="submit" class="btn-principal">
                    Enviar donación
                </button>

            </div>

            <!-- Plantilla para artículos dinámicos -->
            <template id="plantilla-articulo">

                <div class="articulo" data-articulo>

                    <div class="articulo-header">
                        <h3>
                            Artículo <span class="num"></span>
                        </h3>

                        <button type="button" class="btn-quitar">
                            Quitar
                        </button>
                    </div>

                    <label for="Input_Articulos___INDEX___Nombre">
                        Nombre
                    </label>

                    <input type="text"
                           id="Input_Articulos___INDEX___Nombre"
                           name="Input.Articulos[__INDEX__].Nombre"
                           data-val="true"
                           data-val-required="El nombre es obligatorio." />


                    <span data-valmsg-for="Input.Articulos[__INDEX__].Nombre"
                          data-valmsg-replace="true"></span>


                    <label for="Input_Articulos___INDEX___Descripcion">
                        Descripción
                    </label>

                    <input type="text"
                           id="Input_Articulos___INDEX___Descripcion"
                           name="Input.Articulos[__INDEX__].Descripcion" />


                    <label for="Input_Articulos___INDEX___Cantidad">
                        Cantidad
                    </label>

                    <input type="number"
                           min="1"
                           value="1"
                           id="Input_Articulos___INDEX___Cantidad"
                           name="Input.Articulos[__INDEX__].Cantidad" />

                    <span data-valmsg-for="Input.Articulos[__INDEX__].Cantidad"
                          data-valmsg-replace="true"></span>


                    <label for="Input_Articulos___INDEX___Condicion">
                        Condición
                    </label>

                    <select id="Input_Articulos___INDEX___Condicion"
                            name="Input.Articulos[__INDEX__].Condicion">

                        <option value="">Selecciona...</option>
                        <option value="Nuevo">Nuevo</option>
                        <option value="BuenEstado">Buen estado</option>
                        <option value="Usada">Usada</option>

                    </select>


                    <label for="Input_Articulos___INDEX___Foto">Fotografía</label>

                    <div class="foto-campo">
                        <input type="file"
                               accept="image/*"
                               id="Input_Articulos___INDEX___Foto"
                               name="Input.Articulos[__INDEX__].Foto" />

                        <img class="foto-preview" alt="Vista previa de la fotografía" hidden />

                        <button type="button" class="btn-quitar-foto" hidden>Quitar foto</button>
                    </div>

                </div>

            </template>

        </form>

    </div>

</div>
</main>
<!-- FOOTER -->
<footer class="agape-footer">
    <div class="container footer-content">
        <div class="footer-brand">
            <h3>Red Ágape</h3>
            <p>Una red para compartir y ayudar.</p>
        </div>
        <div class="footer-academic">
            <p><strong>Proyecto Final:</strong> Programación Orientada a Objetos 2</p>
            <p><strong>Profesor:</strong> Ing. Jesus Samuel Villalobos Escobar</p>
            <p>&copy; @DateTime.Now.Year - Equipo Ágape</p>
        </div>
    </div>
</footer>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/donar.js"></script>

    <script>
        // Referencias a los elementos que controlan el menú de usuario.
        const btnToggle = document.getElementById('btnUserToggle');
        const dropdownBox = document.getElementById('authDropdownBox');
        const wrapper = document.getElementById('userMenuWrapper');

        if (btnToggle && dropdownBox) {
            // Abre o cierra el menú al pulsar el botón de usuario.
            btnToggle.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdownBox.classList.toggle('show');
            });

            dropdownBox.addEventListener('click', function (e) {
                e.stopPropagation();
            });

            document.addEventListener('click', function (e) {
                // Cierra el menú cuando se hace clic fuera de él.
                if (wrapper && !wrapper.contains(e.target)) {
                    dropdownBox.classList.remove('show');
                }
            });
        }

        function cambiarTabAuth(tabName, btnElement) {
            // Desactiva la pestaña actual y activa la seleccionada.
            document.querySelectorAll('.auth-tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.auth-tab-btn').forEach(b => b.classList.remove('active'));

            document.getElementById('tab-' + tabName).classList.add('active');
            btnElement.classList.add('active');
        }

        function verificarSeguridadPassword() {
            // Comprueba en tiempo real los requisitos de seguridad de la contraseña.
            const pwd = document.getElementById('regPassword')?.value || '';
            const confirmPwd = document.getElementById('regConfirmPassword')?.value || '';

            const tieneLongitud = pwd.length >= 8;
            const tieneMayuscula = /[A-ZÁÉÍÓÚÑ]/.test(pwd);
            const tieneEspecial = /[@@#$%!^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(pwd);
            const coinciden = pwd.length > 0 && pwd === confirmPwd;

            actualizarItemRegla('rule-length', tieneLongitud, 'Mínimo 8 caracteres');
            actualizarItemRegla('rule-upper', tieneMayuscula, 'Al menos una letra mayúscula (A-Z)');
            actualizarItemRegla('rule-special', tieneEspecial, 'Un carácter especial (@@, #, $, %, !, *, etc.)');
            actualizarItemRegla('rule-match', coinciden, 'Las contraseñas coinciden');

            return tieneLongitud && tieneMayuscula && tieneEspecial && coinciden;
        }

        function actualizarItemRegla(idElemento, cumple, texto) {
            // Actualiza el indicador visual de una regla de contraseña.
            const li = document.getElementById(idElemento);
            if (!li) return;
            if (cumple) {
                li.classList.add('valid');
                li.textContent = '✔ ' + texto;
            } else {
                li.classList.remove('valid');
                li.textContent = '○ ' + texto;
            }
        }

        function validarFormularioRegistro() {
            // Impide el envío si alguna regla de seguridad no se cumple.
            if (!verificarSeguridadPassword()) {
                alert('Por favor asegúrate de que la contraseña cumpla con todos los requisitos de seguridad y que ambas coincidan.');
                return false;
            }
            return true;
        }

        function toggleVerPassword(inputId, btnEye) {
            // Alterna entre mostrar y ocultar el contenido de un campo de contraseña.
            const input = document.getElementById(inputId);
            if (!input) return;

            const svgOjoAbierto = '<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
            const svgOjoTachado = '<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

            if (input.type === 'password') {
                input.type = 'text';
                btnEye.innerHTML = svgOjoTachado;
                btnEye.title = 'Ocultar contraseña';
            } else {
                input.type = 'password';
                btnEye.innerHTML = svgOjoAbierto;
                btnEye.title = 'Mostrar contraseña';
            }
        }
    </script>

}